<!--Kenil Part 3-->
<!--Common header and navigation bar-->
<% include ../partials/header.ejs %>
<% include ../partials/main_nav.ejs %>

<main class="container mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <!--Layout for form-->
            <div class="card auth-card p-4 shadow-sm">
                <!--Page title-->
                <h3 class="auth-title text-center mb-3">Change Password</h3>
                <!--Change password form-->
                <form action="/users/change-password" method="POST">
                    <!--Old password input-->
                    <div class="mb-3">
                        <input class="form-control" type="password" name="oldPassword" placeholder="Old Password" required>
                    </div>
                    <!--New password input-->
                    <div class="mb-3">
                        <input class="form-control" type="password" name="newPassword" placeholder="New Password" required>
                    </div>
                    <!--Submit button-->
                    <button class="btn btn-warning w-100" type="submit">Change Password</button>
                </form>
                
                <div class="text-center mt-3 small">
                    <a href="/reports">Back to Reports</a>
                </div>
            </div>
        </div>
    </div>
</main>

</body>
</html>
