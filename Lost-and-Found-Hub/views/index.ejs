<%- include('./partials/header.ejs') %>
<%- include('./partials/main_nav.ejs') %>

<style>
  body {
    background: linear-gradient(135deg, #eef3ff, #ffffff);
  }
  .hero-logo {
    width: 220px;
    height: auto;
  }
</style>

<main class="container mt-4">

  <div class="row">
    <div class="col-12 text-center hero">
      <img src="/Content/lostfound.png" alt="Lost & Found" class="hero-logo">
    </div>
  </div>

  <div class="row mt-4">
    <div class="col-md-8 offset-md-2">
      <div class="card p-4 text-center shadow-sm" style="border-radius:14px;">
        <h1 class="mb-3">Welcome to Lost & Found Hub!</h1>

        <p class="lead text-muted">
          Report lost items, browse submitted reports, and reconnect with your belongings quickly.
        </p>

        <div class="d-flex gap-3 flex-wrap justify-content-center mt-3">
          <a class="btn btn-success px-4" href="/reports">
            <i class="fa-solid fa-list me-2"></i> View Reports
          </a>

          <% if (user) { %>
            <a class="btn btn-outline-primary px-4" href="/reports/add">
              <i class="fa-solid fa-plus me-2"></i> Add Report
            </a>
          <% } else { %>
            <a class="btn btn-outline-primary px-4" href="/users/login">
              <i class="fa-solid fa-user-lock me-2"></i> Login to Add
            </a>
          <% } %>

          <a class="btn btn-light px-4" href="/about">
            <i class="fa-solid fa-circle-info me-2"></i> How it works
          </a>
        </div>
      </div>
    </div>
  </div>

  <footer class="site-footer fixed-bottom mt-4 py-2 text-center">
    <div class="container">
      <small class="text-muted">
        &copy; <%= new Date().getFullYear() %> Lost and Found Hub
      </small>
    </div>
  </footer>

</main>

</body>
</html>
